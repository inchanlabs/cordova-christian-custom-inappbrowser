<?xml version="1.0" encoding="UTF-8"?>

<plugin
    id="cordova-christian-custom-inappbrowser"
    version="1.0.0"
    xmlns="http://apache.org/cordova/ns/plugins/1.0">

    <!-- JavaScript API -->
    <js-module
        name="plugin"
        src="www/plugin.js">

        <clobbers target="cordova.plugins.OSCustomInAppBrowser" />

    </js-module>


    <!-- ========================= -->
    <!-- Android                   -->
    <!-- ========================= -->

    <platform name="android">

        <config-file
            parent="/*"
            target="res/xml/config.xml">

            <feature name="OSCustomInAppBrowser">

                <param
                    name="android-package"
                    value="com.outsystems.plugins.custominappbrowser.OSCustomInAppBrowser" />

            </feature>

            <preference
                name="GradlePluginKotlinEnabled"
                value="true" />

            <preference
                name="GradlePluginKotlinCodeStyle"
                value="official" />

        </config-file>


        <!-- Only INTERNET permission -->
        <config-file
            parent="/manifest"
            target="AndroidManifest.xml">

            <uses-permission
                android:name="android.permission.INTERNET" />

        </config-file>


        <!-- Browser Activity -->
        <config-file
            parent="/manifest/application"
            target="AndroidManifest.xml">

            <activity
                android:name="com.outsystems.plugins.custominappbrowser.OSCustomInAppBrowser$BrowserActivity"
                android:exported="false" />

        </config-file>


        <!-- Kotlin source -->
        <source-file
            src="src/android/OSCustomInAppBrowser.kt"
            target-dir="app/src/main/kotlin/com/outsystems/plugins/custominappbrowser" />

    </platform>


    <!-- ========================= -->
    <!-- iOS                       -->
    <!-- ========================= -->

   <platform name="ios">
        <!-- 1. Properly inject feature into config.xml -->
        <config-file target="config.xml" parent="/*">
            <feature name="OSCustomInAppBrowser">
                <param name="ios-package" value="OSCustomInAppBrowser" />
            </feature>
        </config-file>

        <!-- 2. Enable Swift compilation for iOS builds -->
        <preference name="UseSwiftLanguageVersion" value="5" />

        <!-- 3. Reference your Swift source file -->
        <source-file src="src/ios/OSCustomInAppBrowser.swift" />

        <!-- 4. Required iOS Frameworks -->
        <framework src="WebKit.framework" />
    </platform>

</plugin>
