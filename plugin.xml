<?xml version="1.0" encoding="UTF-8"?>

<plugin
    id="cordova-christian-custom-inappbrowser"
    version="1.0.0"
    xmlns="http://apache.org/cordova/ns/plugins/1.0">

    <js-module
        name="plugin"
        src="www/plugin.js">

        <clobbers target="cordova.plugins.OSCustomInAppBrowser" />

    </js-module>

    <platform name="android">

        <config-file
            parent="/*"
            target="res/xml/config.xml">

            <feature name="OSCustomInAppBrowser">

                <param
                    name="android-package"
                    value="com.outsystems.plugins.custominappbrowser.OSCustomInAppBrowser" />

            </feature>

            <preference
                name="GradlePluginKotlinEnabled"
                value="true" />

            <preference
                name="GradlePluginKotlinCodeStyle"
                value="official" />

        </config-file>

        <config-file
            parent="/manifest"
            target="AndroidManifest.xml">

            <uses-permission
                android:name="android.permission.INTERNET" />

        </config-file>

        <source-file
            src="src/android/OSCustomInAppBrowser.kt"
            target-dir="app/src/main/kotlin/com/outsystems/plugins/custominappbrowser" />

    </platform>

</plugin>
